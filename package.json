{
	"name": "lebenslauf",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev:sveltekit": "vite dev",
		"dev": "bun run dev:sveltekit",
		"dev:all": "concurrently \"bun run dev:sveltekit\" \"bun --cwd=server run start\"",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"bun-types": "^1.3.14",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"concurrently": "^10.0.5"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.3",
		"https": "^1.0.0",
		"postgres": "^3.4.9"
	}
}
